@model _225_cie.Models.Course
@using _225_cie.Models

@{
    ViewData["Title"] = "Course Details";
}

<div class="container mt-4">
    <h2>Course Details</h2>
    <div class="card p-3 shadow-sm col-md-6">
        <h4>@Model.CourseName</h4>
        <hr />
        <p><strong>Course ID:</strong> @Model.CourseId</p>
        <p><strong>Duration:</strong> @Model.Duration</p>
        <p><strong>Original Fees:</strong> ₹@Model.Fees</p>
        <p><strong>Discount:</strong> @Model.DiscountPercentage%</p>
        <!-- Extension Method invocation -->
        <p><strong>Final Fees:</strong> ₹@Model.CalculateFinalFees()</p>
        <p class="text-muted"><small>Response cached: @DateTime.Now.ToString("T")</small></p>

        <div class="mt-3">
            <a asp-action="Enroll" asp-route-courseId="@Model.CourseId" class="btn btn-primary">Enroll Now</a>
            <a asp-action="Index" class="btn btn-outline-secondary">Back to Catalog</a>
        </div>
    </div>
</div>