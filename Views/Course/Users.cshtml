@model IEnumerable<_225_cie.Models.ExternalUser>

@{
    ViewData["Title"] = "External Users";
}

<div class="container mt-4">
    <h2>External User Directory</h2>
    <p class="text-muted">Retrieved asynchronously from https://jsonplaceholder.typicode.com/users</p>

    <table class="table table-bordered table-striped">
        <thead class="table-primary">
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Email</th>
                <th>Company</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.Id</td>
                    <td>@user.Name</td>
                    <td>@user.Email</td>
                    <td>@user.Company?.Name</td>
                </tr>
            }
        </tbody>
    </table>

    <a asp-action="Index" class="btn btn-secondary">Back to Courses</a>
</div>